<script>
    function switchIndustry(type) {
      // Views
      const viewRetail = document.getElementById('view-retail');
      const viewMfg = document.getElementById('view-mfg');
      const viewServices = document.getElementById('view-services');
      const crossStrip = document.getElementById('cross-industry-strip');

      // Buttons
      const tabRetail = document.getElementById('tab-retail');
      const tabMfg = document.getElementById('tab-mfg');
      const tabServices = document.getElementById('tab-services');

      const activeClasses = ['bg-primary-container', 'text-on-primary-container', 'shadow-md'];
      const inactiveClasses = ['text-on-surface-variant', 'hover:text-on-surface', 'hover:bg-surface-container-high/40'];

      // Reset tabs
      [tabRetail, tabMfg, tabServices].forEach(btn => {
        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);
      });

      // Hide all views
      viewRetail.classList.add('hidden');
      viewMfg.classList.add('hidden');
      viewServices.classList.add('hidden');

      if (type === 'retail') {
        viewRetail.classList.remove('hidden');
        tabRetail.classList.add(...activeClasses);
        tabRetail.classList.remove(...inactiveClasses);
        crossStrip.classList.remove('hidden');
      } else if (type === 'mfg') {
        viewMfg.classList.remove('hidden');
        tabMfg.classList.add(...activeClasses);
        tabMfg.classList.remove(...inactiveClasses);
        crossStrip.classList.add('hidden');
      } else if (type === 'services') {
        viewServices.classList.remove('hidden');
        tabServices.classList.add(...activeClasses);
        tabServices.classList.remove(...inactiveClasses);
        crossStrip.classList.add('hidden');
      }
    }

    function updateCalculator() {
      const turnover = parseInt(document.getElementById('slider-turnover').value);
      const staff = parseInt(document.getElementById('slider-staff').value);

      // Labels
      document.getElementById('label-turnover').innerText = turnover >= 100 
        ? `₹${(turnover/100).toFixed(2)} Crore / month` 
        : `₹${turnover} Lakhs / month`;

      document.getElementById('label-staff').innerText = `${staff} Members`;

      // Calculations
      const hoursSavedMonthly = Math.round((staff * 16) + (turnover * 0.4));
      const annualSavingsLakhs = ((staff * 1.45) + (turnover * 0.18)).toFixed(1);
      const revenueBoostPercent = Math.min(28, Math.round(12 + (turnover * 0.08)));

      // Display outputs
      document.getElementById('calc-hours').innerText = `${hoursSavedMonthly} Hours`;
      document.getElementById('calc-savings').innerText = `₹${annualSavingsLakhs} Lakhs`;
      document.getElementById('calc-revenue').innerText = `+${revenueBoostPercent}%`;
    }

    function showPdfFeedback() {
      const btnText = document.getElementById('pdf-btn-text');
      const original = btnText.innerText;
      btnText.innerText = 'Sent to Client Portal (PDF ready)';
      setTimeout(() => {
        btnText.innerText = original;
      }, 3500);
    }
  </script>
